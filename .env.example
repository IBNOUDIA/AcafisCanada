# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required to actually deliver contact form & membership
# registration notifications by email. Create a free account at resend.com,
# generate an API key, then add it to your Vercel project's Environment
# Variables (Settings > Environment Variables) after deployment.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: The "from" address used when sending notification emails.
# Must be a verified sender/domain in your Resend account. Defaults to
# Resend's shared testing address if not set.
RESEND_FROM_EMAIL="ACAFIS Canada <onboarding@resend.dev>"

# CONTACT_TO_EMAIL: Where contact form submissions are sent.
CONTACT_TO_EMAIL="secretariat@acafis.ca"

# MEMBERSHIP_TO_EMAIL: Where new membership registrations are sent.
MEMBERSHIP_TO_EMAIL="finance@acafis.ca"
