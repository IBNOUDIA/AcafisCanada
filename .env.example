# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Required to actually deliver contact form & membership
# registration notifications by email. Create a free account at resend.com,
# generate an API key, then add it to your Vercel project's Environment
# Variables (Settings > Environment Variables) after deployment.
# The key must belong to the Resend account where acafis.ca is verified.
RESEND_API_KEY="MY_RESEND_API_KEY"

# RESEND_FROM_EMAIL: The "from" address used when sending notification emails.
# Must be on a domain verified in your Resend account (acafis.ca is).
# Defaults to notifications@acafis.ca if not set.
RESEND_FROM_EMAIL="ACAFIS Canada <notifications@acafis.ca>"

# CONTACT_TO_EMAIL: Where contact form submissions are sent.
# Official value once a domain is verified on Resend: infos@acafis.ca
CONTACT_TO_EMAIL="infos@acafis.ca"

# MEMBERSHIP_TO_EMAIL: Where new membership registrations are sent.
# Official value once a domain is verified on Resend: acafisfinance2@gmail.com
MEMBERSHIP_TO_EMAIL="acafisfinance2@gmail.com"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Required for real member storage
# and the "Espace Membre" login to work. Create a free project at
# supabase.com, then run supabase/schema.sql once in its SQL Editor to create
# the `members` table. Find both values under Project Settings > API — use
# the service_role key (NOT the anon/public key: it must bypass Row Level
# Security since the server is the only thing reading/writing this table).
# Without these two set, registration still works (card + email) but nothing
# is persisted, and login always returns "not configured".
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# CLAIM_TOKEN_SECRET: Signs the personal "claim your profile" links sent to
# members bulk-imported without a real email (see handleMemberClaim in
# handlers.ts). Any long random string works — generate one with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
# and set the SAME value here and in Vercel. Falls back to an insecure dev
# default if unset, so links are NOT safe to send in production without this.
CLAIM_TOKEN_SECRET="MY_CLAIM_TOKEN_SECRET"
